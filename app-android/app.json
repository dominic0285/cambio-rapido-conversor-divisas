        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./app.plugin.js"
    ],
    "extra": {
      "eas": {
        "projectId": "b43e1684-1872-47f0-9240-66c58e3d8cdc"
